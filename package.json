{
  "name": "worklog",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "WORKLOG_ENV_FILE=/nonexistent/worklog-env WORKLOG_PROFILE=/nonexistent/worklog-profile.json node --test \"shared/**/*.test.ts\" \"server/**/*.test.ts\" \"cli/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:web": "npm --prefix web test -- --watch=false",
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm --prefix web run build",
    "start": "node server/main.ts",
    "launcher": "zsh scripts/build-launcher.sh",
    "skills": "zsh scripts/install-skills.sh",
    "demo": "zsh scripts/demo.sh"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "~5.9"
  }
}
